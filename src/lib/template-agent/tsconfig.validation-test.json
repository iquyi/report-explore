{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": "../../..",
    "paths": {
      "@/*": ["src/*"]
    },
    "rootDir": "../../..",
    "outDir": "../../../.test-dist/template-agent-validation"
  },
  "include": [
    "limits.ts",
    "prompts.ts",
    "schema.ts",
    "types.ts",
    "tests/validation.test.ts",
    "../../../src/app/templates/types.ts"
  ]
}
