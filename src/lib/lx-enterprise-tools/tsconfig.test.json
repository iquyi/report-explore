{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "."
  },
  "include": [
    "constants.ts",
    "instructions.ts",
    "mcp-client.ts",
    "region-resolver.ts",
    "schemas.ts",
    "tools.ts",
    "types.ts",
    "data/region-code.json",
    "tests/**/*.ts"
  ]
}
