{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "..",
    "outDir": "../../../.test-dist/lib"
  },
  "include": [
    "artifact-store.ts",
    "html-safety.ts",
    "mock-report-sources.ts",
    "orchestration.ts",
    "report-markdown.ts",
    "report-log-safety.ts",
    "report-text-protocol.ts",
    "research-tool-control.ts",
    "subagents.ts",
    "types.ts",
    "../report-demo.ts",
    "tests/**/*.ts"
  ]
}
